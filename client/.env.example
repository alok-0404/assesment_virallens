# Base URL of the API as seen by the browser. Keep "/api" when the API is proxied
# (Vite dev proxy, Nginx in Docker, Vercel rewrites). Never put secrets in VITE_* vars.
VITE_API_BASE_URL=/api

# Dev/preview server only: where the Vite proxy forwards /api requests.
VITE_PROXY_TARGET=http://localhost:5000
