{
  "name": "ai-support-server",
  "version": "1.0.0",
  "description": "REST API for the Minimal AI Customer Support Agent (Express + MongoDB + OpenRouter)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
