# ---------- Runtime ----------
NODE_ENV=development
PORT=5000
# Number of reverse proxies in front of the API (1 behind Nginx / Render, 0 locally)
TRUST_PROXY=0

# ---------- Database (MongoDB Atlas) ----------
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai_support?retryWrites=true&w=majority
MONGODB_URI=

# ---------- Auth ----------
# At least 32 random characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
# true in production (HTTPS). Must be true when COOKIE_SAMESITE=none.
COOKIE_SECURE=false
# lax | strict | none
COOKIE_SAMESITE=lax
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# ---------- AI (OpenRouter) ----------
# Server-side secret. Never expose to the client.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_NAME=AI Customer Support Agent
# Optional: override the built-in customer-support system prompt
AI_SYSTEM_PROMPT=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.3
AI_CONTEXT_MESSAGES=20
AI_CONTEXT_MAX_CHARS=12000

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=20
